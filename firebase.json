{
  "hosting": {
    "public": "web",
    "ignore": ["firebase.json", "**/node_modules/**"],
    "headers": [{"source": "/.well-known/apple-app-site-association", "headers": [{"key": "Content-Type", "value": "application/json"}, {"key": "Cache-Control", "value": "public, max-age=3600"}]}],
    "rewrites": [{"source": "/r/**", "run": {"serviceId": "oui-chef-voice", "region": "us-east1"}}]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8085
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "storage": {
      "port": 9199
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}
