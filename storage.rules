rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/completedRecipes/{path=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/completedRecipes/{attemptID}/dish.jpg {
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && attemptID.matches('^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$')
        && request.resource.size > 0 && request.resource.size <= 2000000
        && request.resource.contentType == 'image/jpeg';
    }
  }
}
